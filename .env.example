# Copy these into Vercel (Project Settings > Environment Variables). Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase > Project Settings > API Keys > "Secret keys" > default (sb_secret_...). A legacy service_role key also works.
SUPABASE_SERVICE_ROLE_KEY=paste-the-secret-key-here
HASH_PEPPER=run: openssl rand -hex 32
